JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
PORT=3000
# Chave que o pipeline da Mauad usa para consultar a lista de presença do RSVP
# (header "x-api-key" ou "Authorization: Bearer <chave>"). Gere com: openssl rand -hex 24
RSVP_WEBHOOK_KEY=troque-este-valor-por-outra-chave-aleatoria

# Domínio(s) dedicados ao RSVP. Quando o app é acessado por um destes hosts,
# a raiz "/" mostra a tela do convidado e "/admin" abre direto a área
# administrativa de convidados (em vez do catálogo). Aceita múltiplos hosts
# separados por vírgula.
RSVP_HOST=rsvp.qualifika.com.br

# ---------- Disparo de convites (WhatsApp via Datafy) ----------
# Datafy espelha 1:1 a Cloud API da Meta (mesmo formato de request/response,
# só muda a URL base e o token). Sem essas 3 variáveis, o envio por WhatsApp
# fica desabilitado (o resto do app funciona normalmente).
WHATSAPP_API_BASE=https://cloud.datafyapi.com.br/v1
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Disparo de convites (e-mail via Resend) ----------
# Sem essas 2 variáveis, o envio por e-mail fica desabilitado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=convites@qualifika.com.br
